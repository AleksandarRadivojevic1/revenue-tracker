# Revenue Tracker — runtime configuration.
# In the Pi deployment these are set in ~/server/.env (next to docker-compose.yml),
# NOT copied into the image. For local production testing, copy to .env.

# Port the server listens on. In the container this is 3000 (published as 8092).
# Local dev uses 3001 by default (see server/index.js); dev doesn't read this.
PORT=3000

# Basic Auth. If REV_TRACKER_PASSWORD is empty/unset, auth is DISABLED (dev).
# Set a password in production. Username defaults to "acko".
REV_TRACKER_USER=acko
REV_TRACKER_PASSWORD=

# SQLite database file. In the container this points at the mounted volume.
DB_PATH=/data/payments.db

# Nightly backup target. UNSET DISABLES BACKUPS (deliberately — the only default
# would be the same disk as the original). In the container: /backups (NVMe).
REV_BACKUP_DIR=/backups

# Keep the scheduler in UTC so backup timing is predictable.
TZ=UTC
